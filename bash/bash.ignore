#! /bin/bash

# MAIN ENVS
export DRAFTS=$HOME/etc/dev/drafts
export EDITOR=vim

# OTHER ENVS
export HTTP_SERVERS_FILE=$SEC/http.json

# PATH
export PATH=/usr/local/texlive/2023/bin/x86_64-linux:$PATH
export PATH="/home/yx/.local/bin:$PATH"
export PATH=/home/yx/.cargo/bin:$PATH

source $DRAFTS/sh/mon/mon

function inks(){
    inkscape "$@" & disown
}


# FUNCIONS
function snip(){
    SNIP_DIR="$CONF_VIM/snippets"
    snippets=($(find $SNIP_DIR -mindepth 1 -maxdepth 1 -type f -name "*.snippets" -printf '%P\n'))
    for i in ${!snippets[@]}; do
        snippet=${snippets[$i]}
        names[$i]=${snippet%.*}
    done
    if [[ -z "$1" ]]; then
        cd $SNIP_DIR
    elif [[ "${names[@]}" =~ "$1" ]]; then
        cd -c 'startinsert' $SNIP_DIR/$1.snippets
    else
        echo "error: there is no snippet file named \"$1\"."
        return 1
    fi
}

alias chat="google-chat-linux & disown && exit"

# BIB FUNCTION
function bib() {
    if [ -z "$BIB" ]; then
        echo "BIB env not set."
        return 1
    fi

    if [ "$1" = "send" ]; then
        if [ -z "$2" ]; then
            echo "Usage: bib send <file>"
            return 1
        fi
        
        local file_path=$(realpath "$2")
        local bib_path=$(realpath "$BIB")
        
        if [[ "$file_path" == "$bib_path"/* ]]; then
            local rel_path="${file_path#$bib_path/}"
            
            echo "Sending to lemma:$rel_path..."
            rclone copyto "$file_path" "lemma:$rel_path"
            return $?
        else
            echo "Error: '$2' is not inside $BIB"
            return 1
        fi
    fi

    local line filepath basename
    
    line=$(find "$BIB" -type f -name '*.pdf' \
        | awk -F/ '{print $0 "\t" gensub(/\.pdf$/, "", 1, $NF)}' \
        | sort --reverse -t$'\t' -k2 \
        | fzf --with-nth=2 --delimiter='\t' \
            --preview 'pdftotext {1} -' \
            --preview-window=right:70% \
            --bind 'right:preview-down,left:preview-up,shift-right:preview-page-down,shift-left:preview-page-up')
            
    [ -z "$line" ] && return
    filepath="${line%%$'\t'*}"
    basename="${line#*$'\t'}"
    [ -n "$filepath" ] && zathura "$filepath"
}


function importtime(){
    if [[ -n "$1" ]]; then
        python -X importtime $1 2>&1 | grep "import time:" | awk '{ print $5, $NF }' | sort -rn | head -n ${2:-100}
    fi
}
